# GEMINI_API_KEY: Required for Gemini AI API calls.
# Create a key at https://aistudio.google.com/apikey (or in the GCP console
# with the Generative Language API enabled). Personal GCP projects have no org
# restrictions on API key creation.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string for persistent storage.
# Get this from Supabase (supabase.com) or Neon (neon.tech) — both have free tiers.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Leave unset to run without a database (data stays in localStorage only).
DATABASE_URL=""

# VITE_GOOGLE_MAPS_API_KEY: Required for the commute map view.
VITE_GOOGLE_MAPS_API_KEY=""

# VITE_MICROSOFT_CLIENT_ID: Required for Microsoft / Teams calendar sync.
# Register an app at https://portal.azure.com → Azure Active Directory → App registrations.
# Set redirect URI to your app URL (type: Single-page application).
# Add Microsoft Graph permission: Calendars.Read (delegated).
VITE_MICROSOFT_CLIENT_ID=""
